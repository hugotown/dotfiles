# Credentials and machine-specific configuration
/.env
/.env.*
!/.env.example
/auth.json
/auth.lock
/config.yaml
/pairing/
/platforms/pairing/

# Private conversations, memory, queued messages, and scheduled jobs
/sessions/
/memories/
/pending_messages/
/channel_directory.json
/discord_threads.json
/cron/

# Runtime state and local installation metadata
/.hermes/
/state/
/state.db*
/kanban/
/kanban.db*
/gateway/
/gateway_state.json
/gateway-starts.log
/gateway.lock
/gateway.pid
/install_id
/.install_id.lock
/.codex_gpt55_autoraise_notice

# Caches, downloaded binaries, and generated artifacts
/bin/
/cache/
/audio_cache/
/image_cache/
/sandboxes/
/context_length_cache.yaml
/models_dev_cache.json
/models_dev_cache.etag
/ollama_cloud_models_cache.json
/provider_models_cache.json
/.update_check
/.hermes_history

# Generated skill metadata and backups; skill source files remain versionable
/skills/.bundled_manifest
/skills/.curator_state
/skills/.curator_backups/
/skills/.usage.json
/skills/.usage.json.lock

# Logs, locks, and local configuration backups
/logs/
*.lock
*.pid
*.log
/.env.bak*
/.env.*.bak*
/auth.json.bak*
/config.yaml.bak*

# Python-generated files
__pycache__/
*.py[cod]
.venv/
